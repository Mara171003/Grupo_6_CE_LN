@model Grupo_6_CE_LN.Models.Vehiculo

@{
    ViewData["Title"] = "Crear Vehículo";
}

<h1>@ViewData["Title"]</h1>

<h4>Vehículo</h4>
<hr />

<form asp-action="Create" method="post">
    <div class="form-group">
        <label for="Placa">Placa</label>
        <input type="text" class="form-control" id="Placa" name="Placa" />
    </div>
    <div class="form-group">
        <label for="Modelo">Modelo</label>
        <input type="text" class="form-control" id="Modelo" name="Modelo" />
    </div>
    <div class="form-group">
        <label for="CapacidadPasajeros">Capacidad de Pasajeros</label>
        <input type="number" class="form-control" id="CapacidadPasajeros" name="CapacidadPasajeros" />
    </div>
    <div class="form-group">
        <label for="Estado">Estado</label>
        <select class="form-control" id="Estado" name="Estado">
            <option>Bueno</option>
            <option>Regular</option>
            <option>Necesita mantenimiento</option>
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Crear</button>
</form>
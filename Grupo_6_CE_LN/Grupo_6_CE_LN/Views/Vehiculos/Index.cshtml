@model IEnumerable<Grupo_6_CE_LN.Models.Vehiculo>

@{
    ViewData["Title"] = "Vehículos";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a href="@Url.Action("Create")" class="btn btn-primary">Crear Nuevo Vehículo</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Placa</th>
            <th>Modelo</th>
            <th>Capacidad</th>
            <th>Estado</th>
            <th>Fecha de Registro</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Placa</td>
                <td>@item.Modelo</td>
                <td>@item.CapacidadPasajeros</td>
                <td>@item.Estado</td>
                <td>@item.FechaRegistro</td>
                <td>
                    <a href="@Url.Action("Details", new { id = item.Id })" class="btn btn-info">Detalles</a>
                    <a href="@Url.Action("Edit", new { id = item.Id })" class="btn btn-warning">Editar</a>
                    <a href="@Url.Action("Delete", new { id = item.Id })" class="btn btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>



             
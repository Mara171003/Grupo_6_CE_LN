@model Grupo_6_CE_LN.Models.Vehiculo

@{
    ViewData["Title"] = "Eliminar Vehículo";
}

<h1>@ViewData["Title"]</h1>

<h4>¿Está seguro que desea eliminar este vehículo?</h4>
<hr />

<div>
    <h4>Vehículo</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Placa</dt>
        <dd class="col-sm-10">@Model.Placa</dd>

        <dt class="col-sm-2">Modelo</dt>
        <dd class="col-sm-10">@Model.Modelo</dd>

        <dt class="col-sm-2">Capacidad de Pasajeros</dt>
        <dd class="col-sm-10">@Model.CapacidadPasajeros</dd>

        <dt class="col-sm-2">Estado</dt>
        <dd class="col-sm-10">@Model.Estado</dd>

        <dt class="col-sm-2">Fecha de Registro</dt>
        <dd class="col-sm-10">@Model.FechaRegistro</dd>
    </dl>
</div>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" name="id" value="@Model.Id" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a href="@Url.Action("Index")" class="btn btn-secondary">Cancelar</a>
</form>
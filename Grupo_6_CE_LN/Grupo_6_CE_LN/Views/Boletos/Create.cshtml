@model Grupo_6_CE_LN.Models.Boletos

@{
    ViewData["Title"] = "Crear Boleto";
}

<h1>@ViewData["Title"]</h1>

<h4>Boleto</h4>
<hr />

<form asp-action="Create" method="post">
    <div class="form-group">
        <label for="ID_Usuario">ID Usuario</label>
        <input type="number" class="form-control" id="ID_Usuario" name="ID_Usuario" />
    </div>
    <div class="form-group">
        <label for="IdRuta">ID Ruta</label>
        <input type="number" class="form-control" id="IdRuta" name="IdRuta" />
    </div>
    <div class="form-group">
        <label for="Id">ID Vehiculo</label>
        <input type="number" class="form-control" id="Id" name="Id" />
    </div>
    <div class="form-group">
        <label for="Asiento">Asiento</label>
        <input type="number" class="form-control" id="Asiento" name="Asiento" />
    </div>
    <div class="form-group">
        <label for="Estado">Estado</label>
        <select class="form-control" id="Estado" name="Estado">
            <option>Comprado</option>
            <option>Cancelado</option>
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Crear</button>
</form>
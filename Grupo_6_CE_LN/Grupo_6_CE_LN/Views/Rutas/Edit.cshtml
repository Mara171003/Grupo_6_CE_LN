@model Grupo_6_CE_LN.Models.Rutas

@{
    ViewData["Title"] = "Editar Ruta";
}

<h1>@ViewData["Title"]</h1>

<h4>Ruta</h4>
<hr />

<form asp-action="Edit" method="post">
    <div class="form-group">
        <label for="IdRuta">Codigo de Ruta</label>
        <input type="text" class="form-control" id="IdRuta" name="IdRuta" value="@Model.IdRuta" />
    </div>
    <div class="form-group">
        <label for="NombreRuta">Nombre de la Ruta</label>
        <input type="text" class="form-control" id="NombreRuta" name="NombreRuta" value="@Model.NombreRuta" />
    </div>
    <div class="form-group">
        <label for="Descripcion">Descripcion</label>
        <input type="number" class="form-control" id="Descripcion" name="Descripcion" value="@Model.Descripcion" />
    </div>
    <div class="form-group">
        <label for="Estado">Estado</label>
        <select class="form-control" id="Estado" name="Estado">
            <option selected>@Model.Estado</option>
            <option>Activo</option>
            <option>Inactivo</option>
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Actualizar</button>
</form>
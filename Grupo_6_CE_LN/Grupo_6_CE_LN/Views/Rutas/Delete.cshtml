@model Grupo_6_CE_LN.Models.Rutas

@{
    ViewData["Title"] = "Eliminar Ruta";
}

<h1>@ViewData["Title"]</h1>

<h4>¿Está seguro que desea eliminar esta ruta?</h4>
<hr />

<div>
    <h4>Vehículo</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Codigo de la ruta</dt>
        <dd class="col-sm-10">@Model.IdRuta</dd>

        <dt class="col-sm-2">Nombre de la ruta</dt>
        <dd class="col-sm-10">@Model.NombreRuta</dd>

        <dt class="col-sm-2">Descripcion</dt>
        <dd class="col-sm-10">@Model.Descripcion</dd>

        <dt class="col-sm-2">Estado</dt>
        <dd class="col-sm-10">@Model.Estado</dd>

        <dt class="col-sm-2">Fecha de Registro</dt>
        <dd class="col-sm-10">@Model.FechaRegistro</dd>
    </dl>
</div>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" name="id" value="@Model.IdRuta" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a href="@Url.Action("Index")" class="btn btn-secondary">Cancelar</a>
</form>
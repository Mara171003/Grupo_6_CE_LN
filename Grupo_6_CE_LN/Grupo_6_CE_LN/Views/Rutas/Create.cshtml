@model Grupo_6_CE_LN.Models.Rutas

@{
    ViewData["Title"] = "Crear Ruta";
}

<h1>@ViewData["Title"]</h1>

<h4>Ruta</h4>
<hr />

<form asp-action="Create" method="post">
    <div class="form-group">
        <label for="IdRuta">Codigo de ruta</label>
        <input type="text" class="form-control" id="IdRuta" name="IdRuta" />
    </div>
    <div class="form-group">
        <label for="NombreRuta">Nombre de la Ruta</label>
        <input type="text" class="form-control" id="NombreRuta" name="NombreRuta" />
    </div>
    <div class="form-group">
        <label for="Descripcion">Descripcion</label>
        <input type="number" class="form-control" id="Descripcion" name="Descripcion" />
    </div>
    <div class="form-group">
        <label for="IdParada">Codigo de las paradas</label>
        <input type="text" class="form-control" id="IdParada" name="IdParada" />
    </div>
    <div class="form-group">
        <label for="IdHorario">Codigo de los horarios</label>
        <input type="text" class="form-control" id="IdHorario" name="IdHorario" />
    </div>
    <div class="form-group">
        <label for="Estado">Estado</label>
        <select class="form-control" id="Estado" name="Estado">
            <option>Activo</option>
            <option>Inactivo</option>
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Crear</button>
</form>
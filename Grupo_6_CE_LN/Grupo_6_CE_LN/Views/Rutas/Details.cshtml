@model Grupo_6_CE_LN.Models.Rutas

@{
    ViewData["Title"] = "Detalles de la Ruta";
}

<h1>@ViewData["Title"]</h1>

<div>
    <h4>Ruta</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Codigo de Ruta</dt>
        <dd class="col-sm-10">@Model.IdRuta</dd>

        <dt class="col-sm-2">Nombre de Ruta</dt>
        <dd class="col-sm-10">@Model.NombreRuta</dd>

        <dt class="col-sm-2">Descripcion</dt>
        <dd class="col-sm-10">@Model.Descripcion</dd>

        <dt class="col-sm-2">Estado</dt>
        <dd class="col-sm-10">@Model.Estado</dd>

        <dt class="col-sm-2">Fecha de Registro</dt>
        <dd class="col-sm-10">@Model.FechaRegistro</dd>
    </dl>
</div>

<p>
    <a href="@Url.Action("Edit", new { id = Model.IdRuta })" class="btn btn-warning">Editar</a>
    <a href="@Url.Action("Index")" class="btn btn-primary">Volver</a>
</p>
@model Grupo_6_CE_LN.Models.Usuarios

@{
    ViewData["Title"] = "Detalles del Usuario";
}

<h1>@ViewData["Title"]</h1>

<div>
    <h4>Usuario</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Nombre de Usuario</dt>
        <dd class="col-sm-10">@Model.NombreUsuario</dd>

        <dt class="col-sm-2">Nombre Completo</dt>
        <dd class="col-sm-10">@Model.NombreCompleto</dd>

        <dt class="col-sm-2">Correo Electrónico</dt>
        <dd class="col-sm-10">@Model.Correo</dd>

        <dt class="col-sm-2">Teléfono</dt>
        <dd class="col-sm-10">@Model.Telefono</dd>

        <dt class="col-sm-2">Rol</dt>
        <dd class="col-sm-10">@Model.Roles.NombreRol</dd>
    </dl>
</div>

<p>
    <a href="@Url.Action("Edit", new { id = Model.ID_Usuario })" class="btn btn-warning">Editar</a>
    <a href="@Url.Action("Index")" class="btn btn-primary">Volver</a>
</p>